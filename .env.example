# Docker image tag
IMAGE_TAG=latest

# WebUi — BackendUrl injected at container startup
BACKEND_URL=https://familyhq.api.alphaepsilon.co.uk

# WebApi — Database
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=FamilyHQ;Username=postgres;Password=changeme

# WebApi — JWT
Jwt__SigningKey=changeme

# WebApi — Google Calendar (use Simulator URLs for dev/staging)
GoogleCalendar__ClientId=changeme
GoogleCalendar__ClientSecret=changeme
GoogleCalendar__AuthPromptUrl=https://accounts.google.com/o/oauth2/v2/auth
GoogleCalendar__AuthBaseUrl=https://accounts.google.com
GoogleCalendar__CalendarApiBaseUrl=https://www.googleapis.com/calendar/v3

# WebApi — Weather (use Simulator URL for dev/staging, e.g. http://host:port/simulator)
Weather__BaseUrl=https://api.open-meteo.com

# WebApi — Geocoding (use Simulator URL for dev/staging, e.g. http://host:port/simulator)
Geocoding__BaseUrl=https://nominatim.openstreetmap.org

# WebApi — IP Geolocation (use Simulator URL for dev/staging, e.g. http://host:port/simulator)
Location__IpApiBaseUrl=http://ip-api.com

# WebApi — CORS origin (must match the URL users access the UI on)
FrontendBaseUrl=https://familyhq.alphaepsilon.co.uk

# WebApi — Data Protection certificate
DataProtection__CertificatePassword=changeme

# WebApi — Sync / Webhook registration
# Enabled in every environment. The address Google is told to POST notifications to; the code
# appends /api/sync/webhook, so give the base only. It must be an absolute http(s) URL or the
# WebApi refuses to boot (FHQ-196). Dev and staging point at the Simulator over plain http;
# preprod reaches the internal environment through the RelayRobin relay
# (https://<relay-host>/h/<routeKey> — the route key is a credential: never commit it); prod uses
# its own public API address.
Sync__WebhookRegistrationEnabled=true
Sync__WebhookBaseUrl=http://webapi:8080
# How often the renewal pass runs. 6 days is deliberate and should not be lowered: Google's
# channels last ~7 days and the pass only re-registers one with under 24h left, so a shorter
# interval skips the window and lets the channel expire. Omit to inherit the same 6-day default.
Sync__WebhookRenewalInterval=6.00:00:00

# WebApi — Deployment tier
# dev | staging | preprod | prod. The ONLY thing that tells preprod and prod apart at runtime:
# both run with ASPNETCORE_ENVIRONMENT=Production (preprod deliberately, so it loads prod settings
# and takes prod code paths), so IsProduction() cannot gate anything preprod-only. The same image is
# promoted preprod -> prod, so the preprod smoke endpoints below are switched by this key alone.
# A missing or unrecognised value counts as NOT-allowed: forgetting it fails safe, it does not open
# anything. Set it in every environment's env credential; prod MUST be exactly "prod", and the prod
# deploy pipeline refuses to ship an env file where it is not (FHQ-139).
Deployment__Tier=prod

# WebApi — Smoke test account (preprod only)
# The Google subject identifier (sub) of the smoke test account, seeded by one normal browser
# sign-in on preprod. The issue-token endpoints below can mint credentials for THIS account and no
# other, so a family member's token stays unreachable even if the flag, tier and secret are all
# wrong. Unset is a deny, never a wildcard. Leave empty in dev, staging and prod.
Smoke__UserId=

# WebApi — Preprod smoke token endpoints (preprod only)
# POST /api/auth/issue-token mints a FamilyHQ JWT for a user whose Google refresh token is already
# stored, and POST /api/auth/issue-google-access-token refreshes that stored grant into a live
# Google access token for the smoke suite's Google oracle. Both bypass interactive sign-in, so they
# may be on in preprod (LAN-only) and MUST be off in production — enforced in three layers: this
# flag, a startup refusal (tier prod + enabled = the WebApi will not boot), and the prod deploy
# pipeline's Validate Production Config stage.
# The secret is presented as "Authorization: Bearer <secret>" and is validated by its own
# authentication scheme, so it can never satisfy a user login. Generate it with
# `openssl rand -base64 32`, keep it in the env credential only, and never commit or paste it.
# Leave Enabled=false (or absent) and Secret empty everywhere except preprod.
Auth__IssueTokenEndpoint__Enabled=false
Auth__IssueTokenEndpoint__Secret=

# Simulator — Database (dev/staging only)
Simulator__ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=FamilyHQ-Simulator;Username=postgres;Password=changeme

# PostgreSQL external network name
POSTGRES_NETWORK_NAME=postgres_default

# Production only — nginx-proxy-ssl routing
VIRTUAL_HOST_UI=familyhq.alphaepsilon.co.uk
VIRTUAL_HOST_API=familyhq.api.alphaepsilon.co.uk
LETSENCRYPT_HOST_UI=familyhq.alphaepsilon.co.uk
LETSENCRYPT_HOST_API=familyhq.api.alphaepsilon.co.uk
LETSENCRYPT_EMAIL=admin@alphaepsilon.co.uk
APP_NETWORK_NAME=nginx-proxy-ssl_default

# WebUi — Weather override dev tool
# Set to "true" in dev/staging to show the Weather Override settings tab
# used to preview each WeatherCondition animation. MUST be "false" (or absent)
# in preprod and production. Any value other than the literal string "true" is
# treated as false.
FEATURE_WEATHER_OVERRIDE_ENABLED=false

# WebUi — Clock override dev tool
# Set to "true" in dev/staging to expose window.familyHqKiosk bridge used by
# day-rollover E2E tests. MUST be "false" (or absent) in preprod and production.
# Any value other than the literal string "true" is treated as false.
FEATURE_CLOCK_OVERRIDE_ENABLED=false

# Salt used for Google calendar id obfuscation in logs
# Generate with `openssl rand -base64 32`
Security__RedactionSalt=
