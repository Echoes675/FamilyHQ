<Project Sdk="Microsoft.NET.Sdk">

  <!-- FHQ-141: the preprod smoke suite. Deliberately carries NO reference to any tests-e2e project
       and NO data-access package (no Npgsql, no EF Core, no Data Protection): everything this suite
       knows about preprod it learns from preprod's own API or from Google. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

</Project>
