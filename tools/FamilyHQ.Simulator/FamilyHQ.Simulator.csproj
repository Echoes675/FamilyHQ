<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\src\FamilyHQ.Core\FamilyHQ.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- FHQ-161: the Simulator must expand a recurring master anchored to its start.timeZone, as
         Google does. NodaTime's bundled tzdb is the project's standard zone source (the CI/test
         runtime is globalization-invariant, so TimeZoneInfo is not available). Already pinned
         centrally in Directory.Packages.props for FamilyHQ.Services / FamilyHQ.Data; the Simulator
         is a tools/ test double and is never referenced by the deployed WebUi/WebApi. -->
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d3cd9f0f-9f5f-4c31-8188-b8d9c9cc6111</UserSecretsId>
  </PropertyGroup>


  <Import Project="$(MSBuildThisFileDirectory)../../build/GoogleDateParsingBan.props" />
</Project>
