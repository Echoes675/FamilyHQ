<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\src\FamilyHQ.Core\FamilyHQ.Core.csproj" />
    <ProjectReference Include="..\..\src\FamilyHQ.Time\FamilyHQ.Time.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The Simulator expands a recurring master anchored to its start.timeZone, as Google does, and
         NodaTime's bundled tzdb is this repository's zone source (the CI/test runtime is
         globalization-invariant, so TimeZoneInfo is not available). No NodaTime type is named
         directly in this project any more — the one shared adapter it registers lives in
         FamilyHQ.Time, which brings the package in transitively. The explicit reference is kept so
         that the Simulator's dependency on a tz database stays visible in its own project file; the
         version is pinned centrally in Directory.Packages.props either way. -->
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d3cd9f0f-9f5f-4c31-8188-b8d9c9cc6111</UserSecretsId>
  </PropertyGroup>


  <Import Project="$(MSBuildThisFileDirectory)../../build/GoogleDateParsingBan.props" />
</Project>
