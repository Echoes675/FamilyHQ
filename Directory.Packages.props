<Project>
  <PropertyGroup>
    <!-- Required so the System.Security.Cryptography.Xml PackageVersion pin below actually overrides
         the vulnerable 10.0.7 transitive dependency pulled in by Microsoft.AspNetCore.DataProtection (FHQ-146) -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core -->
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.7" />
    <!-- Pinned above the transitive version pulled in by Microsoft.AspNetCore.DataProtection, which
         the audit rejects. Nine advisories so far, each raising the floor: GHSA-23rf-6693-g89p,
         GHSA-8q5v-6pqq-x66h, GHSA-cvvh-rhrc-wg4q, GHSA-g8r8-53c2-pm3f and GHSA-mmjf-rqrv-855v took it
         to 10.0.10; GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj and GHSA-r955-8q5j-3h83 (published
         2026-10-13, all denial of service) take it to 10.0.13. Read the patched version off the
         advisory rather than guessing a nearby patch — 10.0.8 did not clear the previous batch. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- Transitive, through System.Security.Cryptography.Xml, and separately vulnerable:
         GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. Needs its own pin because lifting the package
         that depends on it does not lift it. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <!-- Data / EF Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.7" />
    <!-- Lifted off the 10.0.7 band by the SignalR.Common pin below, which asks for Options >= 10.0.13.
         Not an advisory of its own: a pin that clears an audit is no use if it leaves the graph
         unresolvable, and the alternative — holding this at 10.0.7 — is the NU1109 downgrade error. -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <!-- Google -->
    <PackageVersion Include="Google.Apis.Calendar.v3" Version="1.69.0.3667" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.69.0" />
    <!-- ASP.NET Core / Blazor -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <!-- Pinned above the transitive 2.0.0 pulled in by Microsoft.AspNetCore.OpenApi: GHSA-v5pm-xwqc-g5wc (FHQ-136) -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.9.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.7" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.13.1" />
    <PackageVersion Include="SunCalcNet" Version="1.2.3" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!-- SignalR -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.7" />
    <!-- Transitive, through the client above, and vulnerable at the version the client asks for:
         GHSA-334f-vvp4-7g6p (published 2026-10-13, denial of service). Pinned rather than solved by
         bumping the client, so the rest of the 10.0.7 band stays on one version and this line says
         which advisory moved it. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.13" />
    <!-- Time zones -->
    <PackageVersion Include="NodaTime" Version="3.2.0" />
    <PackageVersion Include="GeoTimeZone" Version="5.3.0" />
    <!-- Logging / Serilog -->
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <!-- Analyzers -->
    <!-- FHQ-174: bans the DateTimeOffset/DateTime parse overloads that take no DateTimeStyles and so
         resolve a zone-less string with the host machine's UTC offset. Imported by the four projects
         that handle Google Calendar date payloads via build/GoogleDateParsingBan.props. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
    <!-- Versioning -->
    <PackageVersion Include="MinVer" Version="6.0.0" />
    <!-- Testing -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="MockQueryable.Moq" Version="10.0.5" />
    <PackageVersion Include="FluentAssertions" Version="8.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.1.0" />
    <!-- E2E / Reqnroll -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.50.0" />
    <PackageVersion Include="Reqnroll.xUnit" Version="3.3.3" />
    <PackageVersion Include="Reqnroll.Playwright" Version="3.3.3" />
  </ItemGroup>
</Project>