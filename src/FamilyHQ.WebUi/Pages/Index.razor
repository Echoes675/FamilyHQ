@page "/"
@using FamilyHQ.WebUi.Services
@using FamilyHQ.WebUi.Services.Auth
@using FamilyHQ.WebUi.Components.Reauth
@using FamilyHQ.WebUi.Components.Weather
@using FamilyHQ.Core.DTOs
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject ICalendarApiService CalendarApi
@inject SignalRService SignalR
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@inject IAuthenticationService AuthService
@inject IJSRuntime JSRuntime
@inject FamilyHQ.WebUi.Services.KioskTimeProvider Clock
@inject ILogger<Index> Logger

<PageTitle>FamilyHQ Dashboard</PageTitle>

<div class="dashboard-container" id="dashboard-container">
    @if (!_isAuthenticated)
    {
        <!-- Not Authenticated - Show centered login button -->
        <div class="flex flex-col items-center justify-center" style="min-height: 60vh;">
            <BrandLogo Class="brand-logo--login mb-4" />
            <p style="color: var(--theme-text-muted);" class="mb-4">Please sign in to view your calendar</p>
            <button class="btn btn-primary btn-lg" @onclick="OnLoginClicked">Login to Google</button>
        </div>
    }
    else
    {
        <DashboardHeader />
        @if (ReauthBanner.ShouldShow(_connectionStatus))
        {
            <div class="alert alert-warning reauth-banner reauth-banner--dashboard"
                 role="alert"
                 data-testid="reauth-banner-dashboard">
                <div class="reauth-banner__body">
                    <strong class="reauth-banner__heading">Reconnect to Google to resume sync</strong>
                    <p class="reauth-banner__message">@ReauthBanner.FormatMessage(_connectionStatus?.LastError)</p>
                </div>
                <button type="button"
                        class="btn btn-primary reauth-banner__cta"
                        data-testid="reauth-banner-dashboard-cta"
                        @onclick="OnLoginClicked">
                    Reconnect
                </button>
            </div>
        }
        <WeatherStrip />

        <DashboardTabs CurrentView="_currentView" OnViewChanged="OnTabViewChanged" TodayReminderCount="RemindersViewLogic.TodayCount(_upcomingReminders, _remindersToday, _remindersZone)" />

    }

    @if (_isAuthenticated)
    {
    @if (IsLoading)
    {
        <div class="text-center" style="padding-top: 40px; padding-bottom: 40px;">
            <div class="spinner" role="status">
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-2" style="color: var(--theme-text-muted);">Synchronizing Calendar...</p>
        </div>
    }
    else if (_monthView == null)
    {
        <div class="alert alert-warning">
            Failed to load calendar data. Please ensure the backend is running and authenticated.
        </div>
    }
    else
    {
    @if (_currentView == DashboardView.Month)
    {
        <MonthView CurrentMonth="CurrentMonth"
                   Weeks="_weeks"
                   OnPreviousMonth="GoToPreviousMonth"
                   OnNextMonth="GoToNextMonth"
                   OnOpenQuickJump="OpenQuickJumpModal"
                   OnAddEvent="OnMonthAddEvent"
                   OnEditEvent="OpenEditEventModal"
                   OnDayDrillDown="OnMonthDrillDown" />
    }
    else if (_currentView == DashboardView.Day)
    {
        <DayView SelectedDate="_selectedDate"
                 MonthView="_monthView"
                 Calendars="_displayCalendars"
                 OnNavigate="OnDayNavigate"
                 OnOpenDayPicker="OpenDayPickerModal"
                 OnEditEvent="OpenEditEventModal"
                 OnAddEvent="OnDayAddEvent"
                 OnSaveOrder="HandleSaveOrder" />
    }
    else if (_currentView == DashboardView.MonthAgenda)
    {
        <AgendaView CurrentMonth="CurrentMonth"
                    MonthView="_monthView"
                    Calendars="_displayCalendars"
                    OnPreviousMonth="GoToPreviousMonth"
                    OnNextMonth="GoToNextMonth"
                    OnOpenQuickJump="OpenQuickJumpModal"
                    OnAddEvent="OnAgendaAddEvent"
                    OnAddEventForCalendar="OnAgendaAddEventForCalendar"
                    OnDayDrillDown="OnAgendaDrillDown"
                    OnSaveOrder="HandleSaveOrder" />
        @if (_saveOrderError is not null)
        {
            <div class="alert alert-warning">@_saveOrderError</div>
        }
    }
    else if (_currentView == DashboardView.Reminders)
    {
        <RemindersView Rows="_upcomingReminders"
                       Today="_remindersToday"
                       Zone="_remindersZone"
                       OnOpenDay="OnRemindersDrillDown" />
    }
    }
    }
</div>

<QuickJumpModal IsVisible="_showQuickJumpModal"
                CurrentMonth="CurrentMonth"
                OnJump="JumpToDate"
                OnJumpToday="JumpToToday"
                OnClose="CloseQuickJumpModal" />

@* _selectedDate is always initialised in OnInitializedAsync before first render, so no default-guard is needed here. *@
<DayPickerModal IsVisible="_showDayPickerModal"
                InitialDate="_selectedDate"
                OnDatePicked="JumpToPickedDay"
                OnJumpToday="JumpToTodayDayView"
                OnClose="CloseDayPickerModal" />

<EventModal @ref="_eventModal"
            Calendars="_calendars"
            OnSaved="OnEventModalSaved"
            OnDeleted="OnEventModalDeleted" />

@code {
    // The view a page load lands on, and the one an idle kiosk returns to. One named constant for
    // both because they are the same product decision: the family asked for the Reminders timeline
    // to be the first tab AND what the kiosk shows by default, and a wall display that opened on one
    // view and came home to another would be the odd one out, not a feature.
    private const DashboardView HomeView = DashboardView.Reminders;

    private DashboardView _currentView = HomeView;
    private DateTime _selectedDate;

    // Authentication State
    private bool _isAuthenticated;
    private string? _username;
    private string? _userId;

    private DateTime CurrentMonth;
    private bool IsLoading = true;
    private MonthViewModel? _monthView;
    private List<List<DayItem>> _weeks = new();

    // Quick Jump Modal State
    private bool _showQuickJumpModal = false;

    // Day Picker Modal State
    private bool _showDayPickerModal = false;

    // Event Modal
    private EventModal _eventModal = default!;
    private IReadOnlyList<CalendarSummaryViewModel> _calendars = Array.Empty<CalendarSummaryViewModel>();
    private IReadOnlyList<CalendarSummaryViewModel> _displayCalendars = Array.Empty<CalendarSummaryViewModel>();
    private ConnectionStatusDto? _connectionStatus;

    // Reminders state, page-level rather than tab-level. Starts empty before the first fetch —
    // RemindersView renders its "No reminders coming up" state for that, rather than a blank region —
    // and is then kept live by RefreshUpcomingRemindersAsync (on load, on entering the tab, on
    // EventsUpdated, on an event being saved or deleted, and on the per-minute tick below when the
    // month changes).
    //
    // These rows feed two things now, not one: the timeline itself and the Reminders tab's count of
    // what falls today, which has to be right while the family is looking at another tab entirely.
    // That is why the fetch is no longer scoped to the tab that renders the rows.
    private IReadOnlyList<UpcomingReminderEventViewModel> _upcomingReminders = Array.Empty<UpcomingReminderEventViewModel>();
    private DateOnly _remindersToday;
    private TimeZoneInfo _remindersZone = TimeZoneInfo.Utc;

    // The tick that keeps the Reminders timeline honest between fetches. Every minute it re-reads
    // "today" off the clock, which is what keeps a row's PANEL and its "Today"/"Tomorrow" label
    // correct across midnight (both recompute from _remindersToday on every render) with no timer
    // aimed at midnight itself. It refetches from the server only on a month change — see
    // RefileRemindersForTick. Started once per authenticated load and stopped only on disposal,
    // because the count on the Reminders tab has to roll over at midnight whichever tab is showing.
    //
    // Owned through ReminderTickLoop rather than a bare CancellationTokenSource/Task pair: that
    // guards against a stop racing a start and orphaning a loop. Starting once at load is the
    // easiest case it handles, and it stays the owner because losing that guarantee is not worth the
    // lines it would save — see its own remarks.
    private static readonly TimeSpan ReminderTickPeriod = TimeSpan.FromMinutes(1);
    private readonly ReminderTickLoop _reminderTickLoop = new();

    // How long with no touch counts as "nobody is at it". Decided with the family and shared by
    // both idle rules — pulling the date back to today, and returning to the home view — because it
    // is one judgement about the room, not two about the two behaviours.
    private static readonly TimeSpan IdleSnapThreshold = TimeSpan.FromMinutes(15);
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(30);
    private System.Threading.Timer? _idleTimer;
    private IJSObjectReference? _idleModule;
    private DotNetObjectReference<Index>? _devClockRef;

    protected override async Task OnInitializedAsync()
    {
        var today = Clock.GetLocalNow().Date;
        _selectedDate = today;
        CurrentMonth = new DateTime(today.Year, today.Month, 1);
        _remindersToday = DateOnly.FromDateTime(today);
        _remindersZone = Clock.LocalTimeZone;

        // Check authentication state
        _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        _username = await AuthService.GetUsernameAsync();
        _userId = await AuthService.GetUserIdAsync();

        if (!_isAuthenticated)
        {
            // Not authenticated - show login prompt only
            return;
        }

        await LoadConnectionStatusAsync();

        // Authenticated - load calendar data
        _calendars = await CalendarApi.GetCalendarsAsync();
        _displayCalendars = _calendars.Where(c => !c.IsShared && c.IsVisible).ToList();

        SignalR.OnEventsUpdated += RefreshDataFromSignalR;
        SignalR.OnConnectionStatusUpdated += RefreshConnectionStatusFromSignalR;
        await SignalR.StartAsync();

        await LoadMonthDataAsync();

        // Unconditional, whatever view this load lands on: the Reminders tab carries a count of what
        // falls today, so the rows have to be in memory and the clock has to be ticking before the
        // family has touched anything. SwitchToView runs on a tab tap or a drill-down and so never
        // runs on a page load, which makes this the only place a load can do either.
        //
        // This also satisfies the rule the branch here used to guard — that a future change letting
        // the dashboard remember its last-viewed tab must not silently skip the fetch-on-open rule —
        // but structurally rather than by remembering to keep the condition right: there is no
        // landing view this can be wrong for, because it no longer asks what the landing view is.
        //
        // This is the one loop start a load makes: OnAfterRenderAsync starts the idle poll and
        // nothing else. (EnsureRunningAsync is idempotent regardless — see ReminderTickLoop's
        // remarks and its CalledAgainWhileRunning test — so a future second caller would not orphan
        // a loop either.)
        await RefreshUpcomingRemindersAsync();
        await StartReminderTickLoopAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            await JSRuntime.InvokeVoidAsync("pixelOrbit.init", "dashboard-container");
        }
        catch { /* JS interop not available on pre-render */ }

        try
        {
            _idleModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/idle.js");
            await _idleModule.InvokeVoidAsync("init");

            if (Clock.OverrideEnabled)
            {
                _devClockRef = DotNetObjectReference.Create(this);
                await _idleModule.InvokeVoidAsync("attachDevBridge", _devClockRef);
            }

            _idleTimer = new System.Threading.Timer(
                _ => InvokeAsync(CheckIdleSnapAsync), null, PollInterval, PollInterval);
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Idle day-rollover init skipped: JS interop unavailable.");
        }
    }

    private void RefreshDataFromSignalR()
    {
        // Must be invoked on the UI thread. The dispatched task is discarded, so
        // exceptions must be observed here or they vanish silently (FHQ-125).
        InvokeAsync(async () =>
        {
            try
            {
                await LoadConnectionStatusAsync();
                _calendars = await CalendarApi.GetCalendarsAsync();
                _displayCalendars = _calendars.Where(c => !c.IsShared && c.IsVisible).ToList();
                await LoadMonthDataAsync(showSpinner: _monthView is null);
                // Extends the same handler rather than a second SignalR subscription: a sync-driven
                // change can add, move or delete a reminder just as easily as it can an event, so the
                // timeline needs the same "events changed somewhere" signal the grid already reacts to.
                await RefreshUpcomingRemindersAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Dashboard refresh after SignalR events update failed; keeping previous data");
            }
        });
    }

    private void RefreshConnectionStatusFromSignalR()
    {
        InvokeAsync(async () =>
        {
            try
            {
                await LoadConnectionStatusAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Connection-status refresh after SignalR update failed; keeping previous status");
            }
        });
    }

    private async Task LoadMonthDataAsync(bool showSpinner = true)
    {
        if (showSpinner)
        {
            IsLoading = true;
            StateHasChanged();
        }

        _monthView = await CalendarApi.GetEventsForMonthAsync(CurrentMonth.Year, CurrentMonth.Month);

        BuildCalendarGrid();

        if (showSpinner)
            IsLoading = false;

        StateHasChanged();
    }

    private void BuildCalendarGrid()
    {
        _weeks.Clear();

        // Get start of the first week (could be late previous month)
        var firstDayOfMonth = new DateTime(CurrentMonth.Year, CurrentMonth.Month, 1);
        var startDay = firstDayOfMonth.AddDays(-(int)firstDayOfMonth.DayOfWeek);

        var currentDay = startDay;

        // Build 6 weeks to ensure we cover all days cleanly formatted
        for (int row = 0; row < 6; row++)
        {
            var week = new List<DayItem>();
            for (int col = 0; col < 7; col++)
            {
                var dateKey = currentDay.ToString("yyyy-MM-dd");
                var eventsForDay = new List<CalendarEventViewModel>();

                if (_monthView != null && _monthView.Days.ContainsKey(dateKey))
                {
                    eventsForDay = _monthView.Days[dateKey]
                        .OrderByDescending(e => e.IsAllDay)
                        .ThenBy(e => e.Start)
                        .ToList();
                }

                week.Add(new DayItem { Date = currentDay, Events = eventsForDay });
                currentDay = currentDay.AddDays(1);
            }
            _weeks.Add(week);

            // If we've passed the end of the month and completed the row, stop
            if (currentDay.Month > CurrentMonth.Month ||
               (currentDay.Year > CurrentMonth.Year && currentDay.Month == 1))
            {
                break;
            }
        }
    }

    private async Task GoToPreviousMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
        await LoadMonthDataAsync();
    }

    private async Task GoToNextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
        await LoadMonthDataAsync();
    }

    private Task OnMonthDrillDown(DateTime date) => SwitchToView(DashboardView.Day, date);

    private void OnMonthAddEvent(DateTime date) => OpenAddEventModal(date);

    private void OnAgendaAddEvent(DateTime date) => OpenAddEventModal(date);

    private void OnAgendaAddEventForCalendar((DateTime Date, Guid CalendarId) args) =>
        OpenAddEventModal(args.Date, args.CalendarId);

    private Task OnAgendaDrillDown(DateTime date) => SwitchToView(DashboardView.Day, date);

    // The Reminders timeline drills into the Day view exactly as the Month and Agenda views do, and
    // is the first caller that can pass a date OUTSIDE the loaded month: the timeline spans to the
    // end of NEXT month, while the other two only ever offer dates from the month grid they render.
    // SwitchToView already handles that — a date in another month sets CurrentMonth and awaits
    // LoadMonthDataAsync before the Day view reads _monthView — so this needs nothing of its own.
    private Task OnRemindersDrillDown(DateTime date) => SwitchToView(DashboardView.Day, date);

    private string? _saveOrderError;

    private async Task HandleSaveOrder(Dictionary<Guid, int> order)
    {
        _saveOrderError = null;
        try
        {
            await CalendarApi.SaveCalendarOrderAsync(order);
            _calendars = await CalendarApi.GetCalendarsAsync();
            _displayCalendars = _calendars.Where(c => !c.IsShared && c.IsVisible).ToList();
        }
        catch
        {
            _saveOrderError = "Failed to save column order. Please try again.";
        }
        StateHasChanged();
    }

    private Task OnDayNavigate(DateTime date) => SwitchToView(DashboardView.Day, date);

    private void OnDayAddEvent((DateTime Date, Guid CalendarId) args) =>
        OpenAddEventModal(args.Date, args.CalendarId == Guid.Empty ? null : args.CalendarId);

    // View Switching Logic
    private Task OnTabViewChanged(DashboardView view) => SwitchToView(view);

    private async Task SwitchToView(DashboardView view, DateTime? date = null)
    {
        var wasReminders = _currentView == DashboardView.Reminders;
        _currentView = view;
        if (date.HasValue)
        {
            _selectedDate = date.Value.Date;
            if (_selectedDate.Month != CurrentMonth.Month || _selectedDate.Year != CurrentMonth.Year)
            {
                CurrentMonth = new DateTime(_selectedDate.Year, _selectedDate.Month, 1);
                await LoadMonthDataAsync();
            }
        }
        else if (view == DashboardView.Day)
        {
            // Clicking the Day View tab without a specific date (i.e. not via a drill-down)
            // always returns to today — don't preserve a previously drilled-into date.
            _selectedDate = Clock.GetLocalNow().Date;
            if (_selectedDate.Month != CurrentMonth.Month || _selectedDate.Year != CurrentMonth.Year)
            {
                CurrentMonth = new DateTime(_selectedDate.Year, _selectedDate.Month, 1);
                await LoadMonthDataAsync();
            }
        }

        // Entering the tab still re-anchors and refetches; LEAVING it does nothing, because the tick
        // loop now runs for the page's lifetime rather than the tab's — the Reminders tab's count of
        // what falls today has to roll over at midnight whichever view the kiosk is parked on.
        if (view == DashboardView.Reminders && !wasReminders)
        {
            await EnterRemindersViewAsync();
        }

        StateHasChanged();
    }

    // Quick Jump Modal Logic
    private void OpenQuickJumpModal() => _showQuickJumpModal = true;
    private void CloseQuickJumpModal() => _showQuickJumpModal = false;

    private async Task JumpToDate((int Year, int Month) args)
    {
        CurrentMonth = new DateTime(args.Year, args.Month, 1);
        _showQuickJumpModal = false;
        await LoadMonthDataAsync();
    }

    private async Task JumpToToday()
    {
        var today = Clock.GetLocalNow().Date;
        CurrentMonth = new DateTime(today.Year, today.Month, 1);
        _showQuickJumpModal = false;
        await LoadMonthDataAsync();
    }

    // Day Picker Modal Logic
    private void OpenDayPickerModal() => _showDayPickerModal = true;
    private void CloseDayPickerModal() => _showDayPickerModal = false;

    private async Task JumpToPickedDay(DateTime date)
    {
        _showDayPickerModal = false;
        await SwitchToView(DashboardView.Day, date);
    }

    private async Task JumpToTodayDayView()
    {
        _showDayPickerModal = false;
        await SwitchToView(DashboardView.Day, Clock.GetLocalNow().Date);
    }

    private void OnLoginClicked()
    {
        var backendUrl = Configuration["BackendUrl"]
            ?? throw new InvalidOperationException("BackendUrl is not configured.");
        NavigationManager.NavigateTo($"{backendUrl}/api/auth/login", forceLoad: true);
    }

    private async Task LoadConnectionStatusAsync()
    {
        try
        {
            _connectionStatus = await CalendarApi.GetConnectionStatusAsync();
        }
        catch (Exception ex)
        {
            // Expected while the backend is briefly unreachable — status is treated as unknown.
            Logger.LogDebug(ex, "Connection status load failed; treating status as unknown");
            _connectionStatus = null;
        }
    }

    private async Task OnSignOutClicked()
    {
        await AuthService.SignOutAsync();
        _isAuthenticated = false;
        _username = null;
        _userId = null;
        StateHasChanged();
    }

    // Event Modal Logic
    private void OpenAddEventModal(DateTime date, Guid? calendarId = null) =>
        _eventModal.OpenForCreate(date, calendarId);

    private void OpenEditEventModal(CalendarEventViewModel evt) =>
        _eventModal.OpenForEdit(evt);

    private async Task RefreshUpcomingRemindersAsync()
    {
        _upcomingReminders = await CalendarApi.GetUpcomingRemindersAsync();
    }

    // The same fetch, guarded, for the two callers that run AFTER a write the family has already
    // made. A reminders fetch is secondary to the save: by the time this runs the event is saved and
    // the month grid has reloaded, so letting the exception escape the event callback would replace a
    // completed edit with Blazor's unhandled-error UI. A badge and a timeline that are a few rows
    // stale cost the family a glance; an error screen costs them the edit they just watched succeed,
    // and the next tick, SignalR broadcast or tab entry refetches the rows anyway.
    //
    // Only the reminders refresh is wrapped. A LoadMonthDataAsync failure in those handlers means the
    // grid on screen no longer agrees with what was written, which the family must be told about, so
    // it keeps propagating — the guard follows the page's other background fetches
    // (RefreshDataFromSignalR, LoadConnectionStatusAsync), not the primary load.
    private async Task RefreshUpcomingRemindersSafelyAsync()
    {
        try
        {
            await RefreshUpcomingRemindersAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Upcoming-reminders refresh after an event save or delete failed; keeping previous rows");
        }
    }

    // EventModal.OnSaved/OnDeleted fire for every tab the modal can be opened from, and
    // LoadMonthDataAsync always runs because Month/Day/Agenda all read the same month grid
    // regardless of which one is currently showing. The reminders refresh is unconditional for the
    // same reason: the rows are no longer read by one tab. An event edited on the Month view can add
    // or remove a reminder that falls today, which changes the number the Reminders TAB shows while
    // the family is standing in front of the Month view — so refreshing only when the Reminders view
    // is the one showing would leave that number wrong until the next month boundary.
    //
    // No path opens the modal from the Reminders tab today: tapping a row drills into the Day view,
    // and the only OpenForEdit/OpenForCreate callers are wired to the Month, Day and Agenda
    // components, none of which render while the Reminders view does. That is why the refresh has to
    // be unconditional rather than why it can be skipped — every modal save there IS is a save made
    // from some other view.
    private async Task OnEventModalSaved()
    {
        await LoadMonthDataAsync();
        await RefreshUpcomingRemindersSafelyAsync();
        StateHasChanged();
    }

    // Same reasoning and refresh as OnEventModalSaved.
    private async Task OnEventModalDeleted()
    {
        await LoadMonthDataAsync();
        await RefreshUpcomingRemindersSafelyAsync();
        StateHasChanged();
    }

    // The one place that enters the Reminders tab, called from SwitchToView — so the re-anchor and
    // refetch an entry needs exist once rather than at every caller that can reach the tab.
    private async Task EnterRemindersViewAsync()
    {
        // Re-anchor "today" on every entry, not just once at page load: re-opening the tab after a
        // day has rolled over elsewhere must not file freshly-fetched rows against a stale date —
        // that would misplace rows under the wrong heading for up to a minute (until the next tick
        // corrects it) and could trigger a spurious month-change refetch inside that tick besides.
        _remindersToday = DateOnly.FromDateTime(Clock.GetLocalNow().Date);

        // Refetched on entry for what the re-anchor above cannot fix: rows that are WRONG rather
        // than merely filed against a stale date. Refiling is already handled — the re-anchor plus
        // the render SwitchToView triggers recompute every panel and label from the new date, and
        // the tick has been re-anchoring once a minute since page load, so after a long idle the
        // anchor is at most a minute old anyway.
        //
        // What is genuinely missing from memory is server-side change since the last fetch: an event
        // created or deleted on a phone reaches these rows only through a fetch, and the SignalR
        // broadcast that normally triggers one is not a guarantee — a sync that completed while the
        // circuit was down leaves memory behind with nothing to say so. Entering the tab is the
        // cheapest moment to make it current, because it is the moment the rows start being read.
        //
        // The other case is an idle that crossed a month boundary: the month now in range was not in
        // the window when these rows were fetched. The tick refetches for a month change too, but on
        // its own schedule — fetching here is what makes the rows right for the month at the moment
        // the view appears rather than within the following minute.
        await RefreshUpcomingRemindersAsync();
    }

    private Task StartReminderTickLoopAsync() => _reminderTickLoop.EnsureRunningAsync(
        Clock, ReminderTickPeriod, () => InvokeAsync(RefileRemindersForTick), Logger);

    private Task StopReminderTickLoopAsync() => _reminderTickLoop.StopAsync();

    // The tick callback itself. Re-reads "today" from the clock (kiosk-adjusted, so never
    // DateTime.Today) so sections recompute correctly across midnight, and refetches from the server
    // in the one case memory alone cannot resolve: crossing a MONTH. RemindersController's window is
    // [local midnight today, end of next month] — the near edge is midnight, not the instant of the
    // request, which is what lets a row still read "Today" for an event earlier the same day. Going
    // from 31 March to 1 April moves the FAR edge from end-of-April to end-of-May, and the
    // newly-in-window events for May are not in memory — nothing local can conjure them.
    //
    // Crossing MIDNIGHT inside the same month needs no refetch: the window's far edge is unchanged,
    // and all that has changed is which PANEL a row's EventStart falls into and whether its row
    // reads "Today", "Tomorrow" or a date — all of which recompute from _remindersToday on every
    // render regardless.
    //
    // A reminder firing is not a trigger either, and no longer could be: nothing on a row describes
    // a reminder, so there is nothing for a fired one to make stale. The row is filed by its EVENT's
    // start and reads the same before and after every one of its reminders has gone off.
    private async Task RefileRemindersForTick()
    {
        var today = DateOnly.FromDateTime(Clock.GetLocalNow().Date);
        var dayChanged = today != _remindersToday;
        var monthChanged = today.Month != _remindersToday.Month || today.Year != _remindersToday.Year;

        _remindersToday = today;

        if (monthChanged)
        {
            await RefreshUpcomingRemindersAsync();
        }

        // Rendered only when something on screen would actually differ. Unconditional was right while
        // this loop ran for the one tab it redrew; page-level it would diff the whole month grid every
        // minute on a Pi 3B+ for no visible change.
        //
        // The day is the WHOLE condition, deliberately, and it is worth saying why rather than
        // guarding more broadly: a month cannot change without the day changing too, so the refetch
        // above never happens on its own, and nothing else in a tick touches the rows — every other
        // path that refreshes them (the SignalR handler, a modal save or delete, entering the tab)
        // renders for itself. Re-check that if a tick is ever given a second reason to refetch.
        if (dayChanged)
        {
            StateHasChanged();
        }
    }

    private async Task CheckIdleSnapAsync()
    {
        if (_idleModule is null) return;

        var modalOpen = _eventModal.IsOpen || _showQuickJumpModal || _showDayPickerModal;

        double idleMs;
        try
        {
            idleMs = await _idleModule.InvokeAsync<double>("getIdleMs");
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Idle day-rollover check skipped: getIdleMs unavailable.");
            return;
        }

        var today = Clock.GetLocalNow().Date;
        var isDayView = _currentView == DashboardView.Day;
        var anchor = isDayView
            ? DateOnly.FromDateTime(_selectedDate.Date)
            : DateOnly.FromDateTime(CurrentMonth);

        // Both rules are asked about the SAME observed state before either is acted on. Returning
        // home assigns _currentView, which is one of the date rule's own inputs (isDayView, and
        // which anchor it reads), so deciding them one after the other would have the second rule
        // judge a view the family never left it on.
        var snapDate = IdleSnapDecision.ShouldSnap(
            modalOpen, idleMs, IdleSnapThreshold.TotalMilliseconds,
            anchor, DateOnly.FromDateTime(today), isDayView);

        var returnHome = IdleSnapDecision.ShouldReturnToHomeView(
            modalOpen, idleMs, IdleSnapThreshold.TotalMilliseconds, _currentView, HomeView);

        // The date first, so the home view is entered against the snapped date rather than the one
        // being replaced: EnterRemindersViewAsync re-reads the clock itself, but SnapToTodayAsync
        // may reload the month the Reminders timeline drills into.
        //
        // Guarded separately rather than in one try: the two are independent behaviours, and a month
        // reload that fails is no reason to leave the kiosk parked on a view nobody is looking at.
        if (snapDate)
        {
            try
            {
                await SnapToTodayAsync(today);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Idle snap to today failed; will retry on next poll.");
            }
        }

        if (returnHome)
        {
            try
            {
                await ReturnToHomeViewAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Idle return to the home view failed; will retry on next poll.");
            }
        }
    }

    // Returns through SwitchToView — the same path a tab tap takes — rather than assigning
    // _currentView and re-rendering. That is what re-anchors _remindersToday from the clock and
    // refetches the rows, so an idle return needs no refresh of its own. (The per-minute tick needs
    // no start here: it has been running since the page loaded.)
    //
    // It also resets the timeline's sections to their preview state for free: RemindersView keeps
    // the sections expanded by "Show all" in an instance field, and it is rendered only inside the
    // `_currentView == DashboardView.Reminders` branch above, so a kiosk sitting on another view has
    // no instance at all and the one built on return starts collapsed.
    private Task ReturnToHomeViewAsync() => SwitchToView(HomeView);

    private async Task SnapToTodayAsync(DateTime today)
    {
        _selectedDate = today;
        var todayMonth = new DateTime(today.Year, today.Month, 1);
        if (CurrentMonth != todayMonth)
        {
            CurrentMonth = todayMonth;
            await LoadMonthDataAsync();
        }
        StateHasChanged();
    }

    [JSInvokable]
    public Task DevAdvanceClockDays(int days)
    {
        Clock.AdvanceDays(days);
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task DevRunIdleCheck() => CheckIdleSnapAsync();

    public async ValueTask DisposeAsync()
    {
        SignalR.OnEventsUpdated -= RefreshDataFromSignalR;
        SignalR.OnConnectionStatusUpdated -= RefreshConnectionStatusFromSignalR;

        // Awaited to completion before disposing the gate it was holding — ReminderTickLoop.Dispose
        // itself warns against doing this the other way round.
        await StopReminderTickLoopAsync();
        _reminderTickLoop.Dispose();

        if (_idleTimer is not null)
            await _idleTimer.DisposeAsync();

        _devClockRef?.Dispose();

        if (_idleModule is not null)
        {
            try { await _idleModule.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit already gone — nothing to release */ }
        }
    }

}
