@namespace FamilyHQ.WebUi.Components.Dashboard

@* One event with at least one reminder due. data-event-id lets both the E2E suite and the preprod
   smoke suite address a row by what it IS rather than by its position in the list — rows reorder as
   events start and finish, so a positional selector would silently drift to the wrong row. It alone
   is enough to identify a row now: unlike the per-ping row this replaces, there is exactly one row
   per event, never several sharing an id. data-next-reminder-at is carried too, for a scenario that
   needs to tell two rows' "next" instants apart without parsing the rendered text. *@
<div class="reminder-row"
     data-testid="reminder-row"
     data-event-id="@Event.EventId"
     data-next-reminder-at="@Event.NextReminderAt.ToString("O")"
     data-is-default="@(Event.IsDefault ? "true" : "false")"
     @onclick="() => OnOpenEvent.InvokeAsync(Event.EventId)">
    <span class="reminder-row__time">@ReminderRowDisplay.EventTime(Event.EventStart, Event.EventIsAllDay, Zone)</span>
    <span class="reminder-row__icon" aria-hidden="true">@ReminderRowDisplay.MethodIcon(Event.NextReminderMethod)</span>
    <div class="reminder-row__body">
        <span class="reminder-row__title">@Event.EventTitle</span>
        <span class="reminder-row__detail">
            @ReminderRowDisplay.ReminderSummary(Event.ReminderCount, Event.NextReminderMinutes, Event.EventIsAllDay)
        </span>
    </div>
    @if (Event.IsDefault)
    {
        <span class="reminder-row__default-tag" data-testid="reminder-row-default-tag">default</span>
    }
    @* The server substitutes the owning calendar's name as a member when it can resolve one, so an
       empty Members list means it could not — there is no calendar name anywhere to fall back to,
       not just none wired to this view. Rendering nothing here is the honest answer; inventing a
       placeholder ("this calendar") would assert something meaningless to a family reading a wall
       display, which is worse than admitting the gap — the same reasoning behind the standing
       all-day footnote below. *@
    <div class="reminder-row__people">
        @foreach (var member in Event.Members)
        {
            <span @key="member.DisplayName"
                  class="reminder-member-chip"
                  style="--chip-color: @(member.Color ?? "var(--theme-accent)")">@member.DisplayName</span>
        }
    </div>
</div>

@code {
    /// <summary>The event this row renders. Required — there is no meaningful empty row.</summary>
    [Parameter, EditorRequired] public UpcomingReminderEventViewModel Event { get; set; } = default!;

    /// <summary>
    /// The household's zone, for converting <see cref="Event"/>'s UTC-stamped instants before display.
    /// Threaded straight down from <see cref="RemindersView.Zone"/> — required, because there is no
    /// safe default: formatting the raw UTC value, as this row used to, is the bug this parameter
    /// exists to close.
    /// </summary>
    [Parameter, EditorRequired] public TimeZoneInfo Zone { get; set; } = default!;

    /// <summary>Raised with the event's id when the row is tapped. The whole row is the tap target.</summary>
    [Parameter] public EventCallback<Guid> OnOpenEvent { get; set; }
}
