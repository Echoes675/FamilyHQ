@namespace FamilyHQ.WebUi.Components.Dashboard

<div class="reminders-view" data-testid="reminders-view">
    @{
        var sections = Sections;
    }
    @if (RemindersViewLogic.IsEntirelyEmpty(sections))
    {
        <p class="reminders-view__empty" data-testid="reminders-empty">No reminders coming up</p>
    }
    else
    {
        <div class="reminders-view__columns">
            @foreach (var section in sections)
            {
                var slug = RemindersViewLogic.SectionSlug(section.Key);
                <div @key="section.Key" class="reminders-section glass-surface reminders-section--@slug"
                     data-testid="reminder-section-@slug">
                    <h3 class="reminders-section__heading">@section.Heading</h3>
                    @if (section.Rows.Count == 0)
                    {
                        <p class="reminders-section__empty" data-testid="reminder-section-empty">Nothing</p>
                    }
                    else
                    {
                        var expanded = _expanded.Contains(section.Key);
                        <div class="reminders-section__rows">
                            @foreach (var row in RemindersViewLogic.Preview(section, expanded))
                            {
                                <ReminderPingRow @key="(row.EventId, row.TriggerAt, row.Method, row.Minutes)"
                                                 Ping="row"
                                                 Zone="Zone"
                                                 OnOpenEvent="OnOpenEvent" />
                            }
                        </div>
                        @if (!expanded && section.Rows.Count > RemindersViewLogic.PreviewRows)
                        {
                            <button type="button"
                                    class="btn btn-secondary reminders-section__show-all"
                                    data-testid="reminder-section-show-all"
                                    @onclick="() => Expand(section.Key)">
                                Show all @section.Rows.Count
                            </button>
                        }
                    }
                </div>
            }
        </div>
    }

    @* Not conditional, and not dismissible. Google stores a same-day all-day reminder and shows it in
       its own apps, but its API returns no override for it, so those pings are missing from this view
       and always will be — and they are plausibly the most common all-day reminder there is. A timeline
       that looks complete and is not is worse than one that admits the gap. *@
    <p class="reminders-footnote" data-testid="reminders-allday-footnote">
        All-day reminders set for the day itself aren't shown — Google doesn't share them.
    </p>
</div>

@code {
    /// <summary>The flat list of pings to file and render. Empty renders the no-reminders state.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<UpcomingReminderViewModel> Pings { get; set; } = Array.Empty<UpcomingReminderViewModel>();

    /// <summary>The kiosk's current local date — what "Today" and "Tomorrow" are measured against.</summary>
    [Parameter] public DateOnly Today { get; set; }

    /// <summary>The household's week-start day, passed straight through to <see cref="ReminderBucketing"/>.</summary>
    [Parameter] public DayOfWeek WeekStart { get; set; }

    /// <summary>The zone a ping's local day is read in.</summary>
    [Parameter, EditorRequired] public TimeZoneInfo Zone { get; set; } = TimeZoneInfo.Utc;

    /// <summary>Raised with an event's id when one of its pings is tapped.</summary>
    [Parameter] public EventCallback<Guid> OnOpenEvent { get; set; }

    // Which sections the family has asked to see in full. Local, UI-only state — expanding never
    // raises OnOpenEvent or re-fetches Pings, it only changes which rows already in memory are shown.
    private readonly HashSet<ReminderSectionKey> _expanded = [];

    private IReadOnlyList<ReminderSection<UpcomingReminderViewModel>> Sections =>
        ReminderBucketing.File(Pings, p => p.TriggerAt, Today, WeekStart, Zone);

    private void Expand(ReminderSectionKey key) => _expanded.Add(key);
}
