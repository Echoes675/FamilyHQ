@using System.Text.RegularExpressions
@using FamilyHQ.Core.Calendar.Recurrence
@using FamilyHQ.Core.DTOs
@using FamilyHQ.Core.Exceptions
@using FamilyHQ.WebUi.Services
@inject ICalendarApiService CalendarApi
@inject Microsoft.Extensions.Logging.ILogger<EventModal> Logger

@if (_showEventModal)
{
    <div class="modal-backdrop" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">@(_isEditingEvent ? "Edit Event" : "Create Event")</h5>
                        @{
                            // FHQ-18.10: when the opened event is part of a series, surface a plain-English
                            // summary of its rule. Describe can throw on a null/blank rule, so guard first
                            // and degrade to no subtitle (the sync layer leaves RecurrenceRule null on
                            // transient failures, so a recurring event may legitimately have no rule yet).
                            var recurrenceSummary = _wasRecurring && !string.IsNullOrWhiteSpace(_recurrenceRule)
                                ? RecurrenceRuleBuilder.Describe(_recurrenceRule)
                                : null;
                        }
                        @if (recurrenceSummary is not null)
                        {
                            <div class="modal-subtitle" data-testid="recurrence-subtitle">@recurrenceSummary</div>
                        }
                    </div>
                    <button type="button" class="btn-close" @onclick="Close" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Calendars</label>
                        <CalendarChipSelector
                            AllCalendars="SelectableCalendars"
                            SelectedCalendarIds="_selectedCalendarIds"
                            SelectedCalendarIdsChanged="ids => { _selectedCalendarIds = ids; }"
                            EventId="@(_isEditingEvent ? (Guid?)_eventModel.Id : null)"
                            CalendarApi="CalendarApi" />
                        @if (_selectedCalendarIds.Count == 0)
                        {
                            <div class="text-danger mt-1" style="font-size: 0.82rem;">Please select at least one calendar.</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Event Title</label>
                        <input type="text" class="form-input" @bind="_eventModel.Title" placeholder="e.g. Doctor Appointment" />
                    </div>
                    <div class="pill-toggle-row mb-3">
                        <span class="pill-toggle-label" id="allDayLabel">All Day Event</span>
                        <button type="button"
                                class="@($"pill-toggle {(_eventModel.IsAllDay ? "pill-toggle--on" : "pill-toggle--off")}")"
                                data-testid="all-day-toggle"
                                aria-labelledby="allDayLabel"
                                aria-pressed="@_eventModel.IsAllDay.ToString().ToLowerInvariant()"
                                @onclick="ToggleAllDay">
                            @(_eventModel.IsAllDay ? "On" : "Off")
                        </button>
                    </div>
                    <div class="grid-2 mb-3">
                        <div>
                            <label class="form-label">Start Date</label>
                            <input type="date" class="form-input" @bind="_startDate" />
                        </div>
                        <div>
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-input" @bind="_endDate" />
                        </div>
                    </div>
                    @if (!_eventModel.IsAllDay)
                    {
                        <div class="grid-2 mb-3">
                            <div data-testid="start-time-picker">
                                <label class="form-label">Start Time</label>
                                <TimePicker Value="_startTime" ValueChanged="v => _startTime = v" AriaLabel="Start time" />
                            </div>
                            <div data-testid="end-time-picker">
                                <label class="form-label">End Time</label>
                                <TimePicker Value="_endTime" ValueChanged="v => _endTime = v" AriaLabel="End time" />
                            </div>
                        </div>
                    }
                    <div class="mb-3" data-testid="recurrence-section">
                        <label class="form-label">Repeat</label>
                        <RecurrencePicker Start="_eventModel.Start"
                                          @bind-Value="_recurrenceRule"
                                          SelectionCompleteChanged="v => _recurrenceComplete = v" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Location (Optional)</label>
                        <input type="text" class="form-input" @bind="_eventModel.Location" placeholder="e.g. 123 Main St" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description (Optional)</label>
                        <textarea class="form-input" rows="3" @bind="_eventModel.Description"
                                  placeholder="Notes, details…"></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(_modalError))
                    {
                        <div class="alert alert-danger" role="alert" data-testid="event-modal-error">@_modalError</div>
                    }
                </div>
                <div class="modal-footer flex justify-between">
                    <div>
                        @if (_isEditingEvent)
                        {
                            <button type="button" class="btn btn-danger" @onclick="DeleteEvent">Delete</button>
                        }
                    </div>
                    <div>
                        <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
                        <button type="button" class="btn btn-primary" @onclick="SaveEvent"
                                data-testid="event-save-btn"
                                disabled="@(_isSaving || !_recurrenceComplete)">
                            @if (_isSaving)
                            {
                                <span class="spinner spinner-sm" role="status" aria-hidden="true"></span>
                                <span class="sr-only">Saving...</span>
                            }
                            else
                            {
                                <span>Save</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<RecurrenceScopePrompt IsVisible="_showScopePrompt"
                       IsDelete="_scopePromptIsDelete"
                       MemberChangePending="_memberChangePending"
                       OnConfirm="OnScopeConfirmed"
                       OnCancel="OnScopeCancelled" />

@code {
    [Parameter] public IReadOnlyList<CalendarSummaryViewModel> Calendars { get; set; } = Array.Empty<CalendarSummaryViewModel>();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }

    // Pills in the event modal should only expose calendars that represent a real family
    // member — the shared calendar and any hidden calendars are not selectable here.
    // Shared calendar membership is implicit (multi-member events route there automatically)
    // and hidden calendars are intentionally excluded from the kiosk display, so selecting
    // them would be misleading.
    private IReadOnlyList<CalendarSummaryViewModel> SelectableCalendars =>
        Calendars.Where(c => !c.IsShared && c.IsVisible).ToList();

    // FHQ-175: shown only when the server supplied no kiosk-vetted message. A vetted message
    // carries its own advice, so these are the only strings here allowed to say "please try again".
    private const string SaveFailedFallback = "Couldn't save your event — please try again.";
    private const string DeleteFailedFallback = "Couldn't delete this event — please try again.";

    private bool _showEventModal;
    /// <summary>FHQ-63: lets the dashboard defer the idle day-rollover while an event is being edited.</summary>
    public bool IsOpen => _showEventModal;

    private bool _isEditingEvent;
    private EventFormModel _eventModel = new();
    private HashSet<Guid> _selectedCalendarIds = new();
    private string? _modalError;
    private bool _isSaving;
    private bool _recurrenceComplete = true;

    // FHQ-18 recurrence state.
    // _recurrenceRule: the picker's current RRULE (null = does not repeat). Two-way bound.
    // _wasRecurring: whether the loaded event was already part of a series (drives the scope prompt).
    // _originalMemberIds: the member set the edit modal opened with — compared against the
    //   effective member set to decide MemberChangePending for the scope prompt.
    private string? _recurrenceRule;
    private bool _wasRecurring;
    private IReadOnlyList<Guid> _originalMemberIds = Array.Empty<Guid>();
    private bool _showScopePrompt;
    private bool _scopePromptIsDelete;
    private bool _memberChangePending;
    // The effective member ids resolved during Save, captured so the scope-confirm callback
    // (which fires after the prompt) can reuse them without re-deriving from the description.
    private List<Guid> _pendingMemberIds = new();

    // FHQ-174: every boundary the pickers produce goes through EventModalLogic.ToModelInstant /
    // ToPickerWallClock, which anchor an all-day boundary at midnight UTC instead of stamping the
    // BROWSER's offset on a date Google only ever expressed as "yyyy-MM-dd". The reasoning — why
    // midnight UTC is the only representation that survives the Start/End EF converter and formats
    // back to the same date string — is on GoogleAllDayDate and on ToModelInstant.
    private DateTimeOffset ToModelInstant(DateTime wallClock) =>
        EventModalLogic.ToModelInstant(wallClock, _eventModel.IsAllDay, TimeZoneInfo.Local.GetUtcOffset(wallClock));

    private DateTime StartWallClock => EventModalLogic.ToPickerWallClock(_eventModel.Start, _eventModel.IsAllDay);

    private DateTime EndWallClock => EventModalLogic.ToPickerWallClock(_eventModel.End, _eventModel.IsAllDay);

    private DateTime _startDate
    {
        get => StartWallClock.Date;
        set
        {
            var time = StartWallClock.TimeOfDay;
            _eventModel.Start = ToModelInstant(value.Date + time);
            SyncEndDateIfNeeded();
        }
    }

    private DateTime _endDate
    {
        // For all-day events, End is stored as the exclusive next-day boundary
        // (matching Google's contract). Display the inclusive last day so the
        // user sees the date they picked. AddTicks(-1).Date also handles legacy
        // rows where End may have been stored as the inclusive end-of-day tick.
        get => _eventModel.IsAllDay
            ? EndWallClock.AddTicks(-1).Date
            : EndWallClock.Date;
        set
        {
            var time = EndWallClock.TimeOfDay;
            var dt = _eventModel.IsAllDay
                ? value.Date.AddDays(1)
                : value.Date + time;
            _eventModel.End = ToModelInstant(dt);
        }
    }

    // The time pickers are rendered only when the event is NOT all-day, so these two always take
    // the timed branch of ToModelInstant; they are routed through it so there is one construction
    // rule in this component rather than two.
    private TimeOnly _startTime
    {
        get => TimeOnly.FromTimeSpan(StartWallClock.TimeOfDay);
        set
        {
            // Shift end by the same delta so the user-visible duration is preserved
            // when only the start time is moved. Editing the end time independently
            // (see _endTime) does not touch the start.
            var oldStart = _eventModel.Start;
            var newStart = ToModelInstant(StartWallClock.Date + value.ToTimeSpan());
            var delta = newStart - oldStart;
            _eventModel.Start = newStart;
            _eventModel.End = _eventModel.End + delta;
        }
    }

    private TimeOnly _endTime
    {
        get => TimeOnly.FromTimeSpan(EndWallClock.TimeOfDay);
        set => _eventModel.End = ToModelInstant(EndWallClock.Date + value.ToTimeSpan());
    }

    // The times the event had before all-day was switched on, so switching it back off restores them
    // rather than leaving the user on 00:00. Null until the toggle has been switched on at least once
    // in this modal session — an event that opened all-day has no timed state to restore, and falls
    // back to the same 09:00–10:00 a freshly-created event gets.
    private TimeSpan? _timedStartTimeOfDay;
    private TimeSpan? _timedEndTimeOfDay;

    /// <summary>
    /// FHQ-174. Flipping <c>IsAllDay</c> re-routes the getters but does NOT re-derive the stored
    /// boundaries, so the toggle has to do it. Without this, the ordinary create path — tap a day
    /// cell (which seeds 09:00 local), turn All Day on, save, never touching a picker — stored the
    /// 09:00 instant, i.e. 08:00Z on a UTC+1 kiosk. That is the day-shift hazard this ticket exists
    /// to remove, and it would also have polluted the all-day boundary audit that the
    /// existing-data decision rests on.
    /// <para>
    /// Both directions preserve the DATES the pickers are showing and change only the time
    /// component. Switching off restores the times the event carried before it went all-day (or the
    /// 09:00–10:00 create default when it never had any) — see
    /// <see cref="EventModalLogic.TimedWallClocks"/>.
    /// </para>
    /// </summary>
    private void ToggleAllDay()
    {
        // Read the visible dates BEFORE flipping the flag: both picker getters branch on IsAllDay.
        var startDay = _startDate;
        var inclusiveEndDay = _endDate;

        if (_eventModel.IsAllDay)
        {
            var (start, end) = EventModalLogic.TimedWallClocks(
                startDay,
                inclusiveEndDay,
                _timedStartTimeOfDay ?? EventModalLogic.DefaultStartTimeOfDay,
                _timedEndTimeOfDay ?? EventModalLogic.DefaultEndTimeOfDay);

            _eventModel.IsAllDay = false;
            _eventModel.Start = ToModelInstant(start);
            _eventModel.End = ToModelInstant(end);
        }
        else
        {
            _timedStartTimeOfDay = StartWallClock.TimeOfDay;
            _timedEndTimeOfDay = EndWallClock.TimeOfDay;

            var (start, end) = EventModalLogic.AllDayWallClocks(startDay, inclusiveEndDay);

            _eventModel.IsAllDay = true;
            _eventModel.Start = ToModelInstant(start);
            _eventModel.End = ToModelInstant(end);
        }
    }

    private IEnumerable<Guid> DetectMemberIdsInDescription(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
            return Array.Empty<Guid>();

        // Match whole-word, case-insensitive. Unknown names are skipped.
        // Only selectable calendars (non-shared, non-hidden) are candidates — mentioning the
        // shared calendar name in the description should not tag the event with the shared
        // calendar as a member, since shared is the routing target, not a member.
        var matched = new List<Guid>();
        foreach (var cal in SelectableCalendars)
        {
            if (Regex.IsMatch(description, $@"\b{Regex.Escape(cal.DisplayName)}\b", RegexOptions.IgnoreCase))
                matched.Add(cal.Id);
        }
        return matched;
    }

    private void SyncEndDateIfNeeded()
    {
        if (_eventModel.End < _eventModel.Start)
        {
            _eventModel.End = EventModalLogic.MinimumEnd(_eventModel.Start, _eventModel.IsAllDay);
        }
    }

    public void OpenForCreate(DateTime date, Guid? calendarId = null)
    {
        _isEditingEvent = false;
        var start = date.Hour == 0 && date.Minute == 0 ? date.AddHours(9) : date;
        var end = start.AddHours(1);
        _eventModel = new EventFormModel
        {
            Title = "",
            // A freshly-opened create modal is always timed, so these take ToModelInstant's timed
            // branch. If the user then turns All Day on, ToggleAllDay re-derives BOTH boundaries at
            // midnight UTC — flipping the flag alone would leave these 09:00 local instants in place.
            Start = EventModalLogic.ToModelInstant(start, isAllDay: false, TimeZoneInfo.Local.GetUtcOffset(start)),
            End = EventModalLogic.ToModelInstant(end, isAllDay: false, TimeZoneInfo.Local.GetUtcOffset(end)),
            IsAllDay = false
        };
        // FHQ-32: no silent default. Only an explicitly-passed calendarId seeds the
        // selection; otherwise the modal opens with nothing selected and Save is blocked
        // by the empty-selection validation until the user picks a calendar.
        _selectedCalendarIds = EventModalLogic.InitialCreateSelection(calendarId);
        _timedStartTimeOfDay = null;
        _timedEndTimeOfDay = null;
        // A new event is never recurring and has no pre-existing members to compare against.
        _recurrenceRule = null;
        _recurrenceComplete = true;
        _wasRecurring = false;
        _originalMemberIds = Array.Empty<Guid>();
        _modalError = null;
        _showEventModal = true;
        StateHasChanged();
    }

    public void OpenForEdit(CalendarEventViewModel evt)
    {
        _isEditingEvent = true;
        _eventModel = new EventFormModel
        {
            Id = evt.Id,
            Title = evt.Title,
            Start = evt.Start,
            End = evt.End,
            IsAllDay = evt.IsAllDay,
            Location = evt.Location,
            Description = evt.Description,
            AllCalendars = evt.AllCalendars.ToList()
        };
        _selectedCalendarIds = evt.AllCalendars.Select(c => c.Id).ToHashSet();
        // A loaded event carries no "times before it went all-day" — an all-day one that is toggled
        // off in this session takes the 09:00–10:00 create default instead.
        _timedStartTimeOfDay = null;
        _timedEndTimeOfDay = null;
        // Seed the picker from the loaded event's rule and remember the recurring state + members
        // so Save/Delete can decide whether to prompt for scope and whether a member change is pending.
        _recurrenceRule = evt.RecurrenceRule;
        _recurrenceComplete = true;
        _wasRecurring = evt.IsRecurring;
        _originalMemberIds = evt.AllCalendars.Select(c => c.Id).ToList();
        _modalError = null;
        _showEventModal = true;
        StateHasChanged();
    }

    private void Close()
    {
        _showEventModal = false;
        _showScopePrompt = false;
        _eventModel = new();
        _modalError = null;
        _recurrenceRule = null;
        _recurrenceComplete = true;
        _wasRecurring = false;
        _originalMemberIds = Array.Empty<Guid>();
        _pendingMemberIds = new();
        _memberChangePending = false;
        _timedStartTimeOfDay = null;
        _timedEndTimeOfDay = null;
    }

    private async Task SaveEvent()
    {
        _modalError = null;

        if (string.IsNullOrWhiteSpace(_eventModel.Title))
        {
            _modalError = "Title is required.";
            return;
        }

        if (!_recurrenceComplete)
        {
            _modalError = "Choose how often the event repeats, or turn off Repeat.";
            return;
        }

        // Merge pill selection with any member names detected in the description.
        // The description is the source of truth for extra members — pills are additive.
        // Unknown names in the description are ignored.
        var effectiveMemberIds = new HashSet<Guid>(_selectedCalendarIds);
        foreach (var id in DetectMemberIdsInDescription(_eventModel.Description))
        {
            effectiveMemberIds.Add(id);
        }

        if (effectiveMemberIds.Count == 0)
        {
            _modalError = NoMembersException.UserFacingMessage;
            return;
        }
        if (_eventModel.End < _eventModel.Start)
        {
            _modalError = "End time must be after start time.";
            return;
        }

        // Remember the members actually being saved so a deferred scope-confirm can reuse them.
        _pendingMemberIds = effectiveMemberIds.ToList();

        var action = EventModalLogic.DecideSave(
            isNewEvent: !_isEditingEvent,
            wasRecurring: _wasRecurring,
            hasRuleNow: _recurrenceRule != null);

        // Editing an existing series defers to the scope prompt; the actual service call runs
        // in OnScopeConfirmed once the user picks This / This-and-following / All.
        if (action == EventSaveAction.PromptScope)
        {
            _memberChangePending = EventModalLogic.MembersChanged(_originalMemberIds, _pendingMemberIds);
            _scopePromptIsDelete = false;
            _showScopePrompt = true;
            return;
        }

        _isSaving = true;
        try
        {
            switch (action)
            {
                case EventSaveAction.Create:
                case EventSaveAction.CreateSeries:
                    // RecurrenceRule is null for Create and the chosen RRULE for CreateSeries — the
                    // service treats a null rule as a single event, so one branch covers both.
                    await CalendarApi.CreateEventAsync(new CreateEventRequest(
                        _pendingMemberIds,
                        _eventModel.Title,
                        _eventModel.Start,
                        _eventModel.End,
                        _eventModel.IsAllDay,
                        _eventModel.Location,
                        _eventModel.Description,
                        _recurrenceRule));
                    break;

                case EventSaveAction.Update:
                case EventSaveAction.UpdateRecurrenceOn:
                    // RecurrenceRule null → plain update; non-null on a non-recurring event → toggle ON.
                    await CalendarApi.UpdateEventAsync(_eventModel.Id, new UpdateEventRequest(
                        _eventModel.Title,
                        _eventModel.Start,
                        _eventModel.End,
                        _eventModel.IsAllDay,
                        _eventModel.Location,
                        _eventModel.Description,
                        _recurrenceRule));
                    break;

                default:
                    throw new InvalidOperationException($"Unhandled immediate save action: {action}.");
            }

            Close();
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _modalError = UserFacingMessage.ForFailure(ex, SaveFailedFallback);
            Logger.LogError(ex, "Failed to save the event from the modal.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteEvent()
    {
        if (_eventModel.Id == Guid.Empty) return;

        if (EventModalLogic.DecideDelete(_wasRecurring) == EventDeleteAction.PromptScope)
        {
            // A delete never changes members, so the prompt is never member-gated.
            _memberChangePending = false;
            _scopePromptIsDelete = true;
            _showScopePrompt = true;
            return;
        }

        _isSaving = true;
        try
        {
            await CalendarApi.DeleteEventAsync(_eventModel.Id);
            Close();
            await OnDeleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            _modalError = UserFacingMessage.ForFailure(ex, DeleteFailedFallback);
            Logger.LogError(ex, "Failed to delete event {EventId} from the modal.", _eventModel.Id);
        }
        finally
        {
            _isSaving = false;
        }
    }

    // Invoked when the user confirms the recurrence-scope prompt (edit or delete of a series).
    private async Task OnScopeConfirmed(RecurrenceScope scope)
    {
        _showScopePrompt = false;
        _isSaving = true;
        try
        {
            if (_scopePromptIsDelete)
            {
                await CalendarApi.DeleteRecurringEventAsync(_eventModel.Id, scope);
                Close();
                await OnDeleted.InvokeAsync();
                return;
            }

            var isClearing = _recurrenceRule == null;
            var recurringAction = EventModalLogic.DecideRecurringSave(isClearing);
            var updateReq = new UpdateEventRequest(
                _eventModel.Title,
                _eventModel.Start,
                _eventModel.End,
                _eventModel.IsAllDay,
                _eventModel.Location,
                _eventModel.Description,
                // Carry the rule when editing the series; when clearing, leave it null and set the flag.
                RecurrenceRule: isClearing ? null : _recurrenceRule,
                ClearRecurrence: recurringAction == RecurringSaveAction.ClearRecurrence);

            if (recurringAction == RecurringSaveAction.ClearRecurrence)
            {
                // Collapsing a series is a whole-series single-event update (EffectiveScope forces
                // AllInSeries); the chosen pill does not apply.
                await CalendarApi.UpdateEventAsync(_eventModel.Id, updateReq);
            }
            else
            {
                await CalendarApi.UpdateRecurringEventAsync(
                    _eventModel.Id, updateReq, EventModalLogic.EffectiveScope(scope, isClearing));
            }

            Close();
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _modalError = UserFacingMessage.ForFailure(ex, SaveFailedFallback);
            Logger.LogError(ex, "Failed to save the event from the modal.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    // Dismissing the scope prompt returns to the open modal with no service call.
    private void OnScopeCancelled()
    {
        _showScopePrompt = false;
        _memberChangePending = false;
    }

    private class EventFormModel
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public DateTimeOffset Start { get; set; }
        public DateTimeOffset End { get; set; }
        public bool IsAllDay { get; set; }
        public string? Location { get; set; }
        public string? Description { get; set; }
        public List<CalendarSummaryViewModel> AllCalendars { get; set; } = new();
    }
}
