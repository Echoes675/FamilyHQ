@namespace FamilyHQ.WebUi.Components.Weather
@using FamilyHQ.WebUi.Services
@implements IDisposable
@inject IWeatherUiService WeatherService

@* FHQ-159: current and forecast are independently retained, so they are independently rendered.
   Tying the whole strip to CurrentWeather meant a current reading hidden at its 1-hour window took
   a forecast still inside its 6-hour window down with it. The strip itself disappears only when
   there is nothing fresh to show, which is the same reflow as weather being unconfigured. *@
@if (WeatherService.IsEnabled && (Current is not null || ForecastDays.Count > 0))
{
    <div class="weather-strip glass-surface">
        @if (Current is not null)
        {
            <div class="weather-strip__current">
                <WeatherIcon IconName="@Current.IconName"
                             IsWindy="@Current.IsWindy"
                             Size="22" />
                <span class="weather-strip__temp">@FormatTemp(Current.Temperature)</span>
                <span class="weather-strip__condition">@FormatCondition(Current.Condition)</span>
            </div>
        }

        @if (ForecastDays.Count > 0)
        {
            @* The divider separates two sections; with only one rendered there is nothing to divide. *@
            @if (Current is not null)
            {
                <div class="weather-strip__divider"></div>
            }
            <div class="weather-strip__forecast" data-testid="weather-strip-forecast">
                @foreach (var day in ForecastDays.Take(5))
                {
                    <div @key="day.Date" class="weather-strip__forecast-day">
                        <span class="weather-strip__day-name">@day.Date.ToString("ddd")</span>
                        <WeatherIcon IconName="@day.IconName" IsWindy="@day.IsWindy" Size="16" />
                        <span class="weather-strip__day-temps">
                            <strong>@FormatTemp(day.High)</strong>/@FormatTemp(day.Low)
                        </span>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private FamilyHQ.Core.DTOs.CurrentWeatherDto? Current => WeatherService.CurrentWeather;

    private List<FamilyHQ.Core.DTOs.DailyForecastItemDto> ForecastDays => WeatherService.DailyForecast;

    protected override void OnInitialized()
    {
        WeatherService.OnWeatherChanged += HandleWeatherChanged;
    }

    private void HandleWeatherChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private static string FormatTemp(double temp) => $"{temp:F0}°";

    private static string FormatCondition(FamilyHQ.Core.Enums.WeatherCondition condition) => condition switch
    {
        FamilyHQ.Core.Enums.WeatherCondition.PartlyCloudy => "Partly Cloudy",
        FamilyHQ.Core.Enums.WeatherCondition.LightRain => "Light Rain",
        FamilyHQ.Core.Enums.WeatherCondition.HeavyRain => "Heavy Rain",
        _ => condition.ToString()
    };

    public void Dispose()
    {
        WeatherService.OnWeatherChanged -= HandleWeatherChanged;
    }
}
