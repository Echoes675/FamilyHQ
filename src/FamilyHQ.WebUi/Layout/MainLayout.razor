@inherits LayoutComponentBase
@using FamilyHQ.WebUi.Services
@using FamilyHQ.WebUi.Components
@using FamilyHQ.WebUi.Components.Weather
@using FamilyHQ.WebUi.Services.Auth
@inject IThemeService ThemeService
@inject IKioskTimeZoneReporter KioskTimeZoneReporter
@inject IDisplaySettingService DisplaySettingService
@inject IWeatherUiService WeatherUiService
@inject IAuthenticationService AuthService

<div class="page">
    <UpdateBanner />
    <ConnectionLostIndicator />
    @* <WeatherOverlay /> — temporarily disabled while animations are reworked *@
    <ErrorBoundary @ref="_errorBoundary">
        <ChildContent>
            @Body
        </ChildContent>
        <ErrorContent>
            <div class="error-boundary-container">
                <div class="glass-surface error-boundary-card">
                    <h2>Something went wrong</h2>
                    <p>An unexpected error occurred. Please try again.</p>
                    <button class="btn btn-primary" @onclick="Recover">Reload</button>
                </div>
            </div>
        </ErrorContent>
    </ErrorBoundary>
    <Footer />
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override async Task OnInitializedAsync()
    {
        await DisplaySettingService.InitialiseAsync();  // must run first so ThemeService can read ThemeSelection
        await ThemeService.InitialiseAsync();
        if (await AuthService.IsAuthenticatedAsync())
        {
            // FHQ-178: report this kiosk's own OS time zone. Every load, not once — that is what
            // makes a change to the kiosk's timezone propagate, with nothing to poll.
            await KioskTimeZoneReporter.ReportAsync();
            await WeatherUiService.InitialiseAsync();
        }
    }

    private void Recover()
    {
        _errorBoundary?.Recover();
    }
}
